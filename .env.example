# Asset Management System Configuration
#
# Copy to .env. The three secrets below have no defaults: docker compose
# refuses to start until they are set, because a default would be a secret
# published in this repository.

# ── Secrets (required) ────────────────────────────────────────────────────
# Signs login tokens. Anyone who knows it can act as any user.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Signs MCP OAuth tokens. Same consequence, through the MCP server.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_JWT_SECRET=
# Encrypts stored AI API keys and MFA secrets (Fernet).
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# To change it later, move the old value to ENCRYPTION_KEY_PREVIOUS first;
# ops/bin/am-rotate-secrets.sh does the whole sequence.
ENCRYPTION_KEY=
#ENCRYPTION_KEY_PREVIOUS=

# ── Backend (FastAPI) ─────────────────────────────────────────────────────
# "production" refuses to start with development secrets, wildcard CORS, or
# the default admin password still active.
APP_ENV=development
BACKEND_PORT=18100
JWT_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:15173,http://127.0.0.1:5173,http://127.0.0.1:15173
MCP_TOKEN_AUDIENCE=asset-management-backend
MCP_ALLOWED_ISSUERS=http://localhost:13000,https://localhost:13000

# ── Network exposure ──────────────────────────────────────────────────────
# Address each published port listens on. Database, backend and MCP default
# to loopback; only the frontend is reachable from other devices.
#DB_BIND=127.0.0.1
#BACKEND_BIND=127.0.0.1
#MCP_BIND=127.0.0.1
#FRONTEND_BIND=0.0.0.0
DB_PORT=5434
FRONTEND_PORT=15173

# ── Admin console (separate process / network) ─────────────────────────────
# Bind only to loopback or a VPN address; never 0.0.0.0 or a public/LAN address.
#ADMIN_BIND=127.0.0.1
#ADMIN_PORT=18300
# Host names only (no port). Add the VPN address/name explicitly when used.
#ADMIN_ALLOWED_HOSTS=127.0.0.1,localhost
# Default origins follow ADMIN_PORT. Override with exact trusted origins only.
#ADMIN_ALLOWED_ORIGINS=http://127.0.0.1:18300,http://localhost:18300
# Set 1 when serving the console over HTTPS.
#ADMIN_COOKIE_SECURE=0
# npm run dev:admin uses http://127.0.0.1:15380. For development, explicitly set:
#ADMIN_ALLOWED_ORIGINS=http://127.0.0.1:18300,http://localhost:18300,http://127.0.0.1:15380
# Also add http://localhost:15380 only if opening that dev-server origin.

# ── Database ──────────────────────────────────────────────────────────────
# Each process connects with its own role (backend/app/db_access.py):
#   am_owner      migrations only (the one-shot migrate service)
#   am_user_app   the user backend
#   am_admin_app  the admin backend and CLI
# Create the roles once with ops/bin/am-db-roles.sh --apply (it also hands the
# tables to am_owner); re-run it after changing a password to rotate it.
# Letters and digits only (they go into connection URLs), each different:
#   openssl rand -hex 32
AM_DB_OWNER_PASSWORD=
AM_DB_USER_APP_PASSWORD=
AM_DB_ADMIN_APP_PASSWORD=
# The superuser keeps its password only for emergencies; applied only when the
# volume is first created. For an existing database change it with
# ALTER ROLE postgres PASSWORD '...' first (the ops jobs use the container's
# local socket and keep working).
#POSTGRES_PASSWORD=postgres

# ── Logging ───────────────────────────────────────────────────────────────
#LOG_FORMAT=json        # json | text
#LOG_LEVEL=INFO
#LOG_DB_CHANGES=1       # one line per row written, at commit
#LOG_SLOW_SQL_MS=500    # statements at or above this are logged
#LOG_SQL=0              # 1 logs every statement (needs LOG_LEVEL=DEBUG)
#MCP_LOG_BODIES=0       # 1 logs MCP request/response bodies (financial data)

# ── Frontend (Vite dev server only) ───────────────────────────────────────
VITE_API_URL=http://localhost:18100

# ── MCP HTTP server ───────────────────────────────────────────────────────
MCP_APP_ENV=development
MCP_PORT=13000
MCP_BASE_URL=http://localhost:13000
BACKEND_TOKEN_AUDIENCE=asset-management-backend

# Backend credentials used only by the MCP stdio fallback
BACKEND_USERNAME=your-username
BACKEND_PASSWORD=your-password
