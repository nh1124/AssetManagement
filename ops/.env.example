# Copied once to ~/.config/am-ops/config.env by ops/install.sh.
# Shell syntax; leave optional values commented to use common.sh defaults.
# Repository used by am-admin, am-db-roles and am-rotate-secrets. ops/install.sh
# replaces this with the checkout it runs from (not from a linked worktree; an
# existing different value is kept unless install.sh --set-repo-dir).
AM_REPO_DIR="$HOME/AssetManagement"
# Exact VPN IP address (no port/brackets) additionally trusted by am-status.
# Never set this to a wildcard/public/LAN address.
#AM_ADMIN_ALLOWED_BIND=100.64.0.10
# Existing installations with this override must add finance-admin by hand.
#AM_CONTAINERS="finance-db finance-backend finance-frontend finance-mcp finance-admin"
#AM_BACKUP_ROOT="$HOME/backups/assetmanagement"
#AM_STATE_DIR="$HOME/.local/state/am-ops"
#AM_MIRROR_DIRS=""
#AM_GPG_PASSPHRASE_FILE=""
#AM_HEARTBEAT_URL_BACKUP=""
#AM_HEARTBEAT_URL_WATCHDOG=""
#AM_PROBE_URL=http://127.0.0.1:15173/api/health
#AM_WD_AUTO_RESTART=1
